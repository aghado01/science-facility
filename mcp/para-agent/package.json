  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
