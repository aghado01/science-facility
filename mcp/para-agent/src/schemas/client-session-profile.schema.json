{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:science-facility:para-agent:schema:client-session-profile:1",
  "title": "Para-Agent Client Session Profile",
  "type": "object",
  "required": ["schema_version", "id", "revision", "workspace", "policy", "environment"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "$ref": "#/$defs/revision" },
    "workspace": { "$ref": "#/$defs/id" },
    "policy": {
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "$ref": "#/$defs/policyValues" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentEntry" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$",
      "maxLength": 128
    },
    "envName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "policyValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "minLength": 1, "maxLength": 128 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        }
      ]
    },
    "policyValues": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/policyValue" }
    },
    "literalEntry": {
      "type": "object",
      "required": ["name", "kind", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/envName" },
        "kind": { "const": "literal" },
        "value": { "type": "string", "pattern": "^[^\\u0000]*$" }
      },
      "additionalProperties": false
    },
    "inheritEntry": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/envName" },
        "kind": { "const": "inherit" }
      },
      "additionalProperties": false
    },
    "sourceEntry": {
      "type": "object",
      "required": ["name", "kind", "source_id"],
      "properties": {
        "name": { "$ref": "#/$defs/envName" },
        "kind": { "const": "source" },
        "source_id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "unsetEntry": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/envName" },
        "kind": { "const": "unset" }
      },
      "additionalProperties": false
    },
    "environmentEntry": {
      "oneOf": [
        { "$ref": "#/$defs/literalEntry" },
        { "$ref": "#/$defs/inheritEntry" },
        { "$ref": "#/$defs/sourceEntry" },
        { "$ref": "#/$defs/unsetEntry" }
      ]
    }
  }
}
