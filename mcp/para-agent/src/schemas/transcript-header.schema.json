{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:science-facility:para-agent:schema:transcript-header:1",
  "title": "Para-Agent Transcript Header",
  "description": "The immutable first physical row of a para-agent mediation transcript. Participants are stable logical seats. Client bindings in this row are defaults only; exchange-time native observations remain authoritative.",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "transcript_id",
    "created_at",
    "schemas",
    "producer",
    "session",
    "workspace",
    "participants"
  ],
  "properties": {
    "record_type": {
      "const": "transcript_header"
    },
    "schema_version": {
      "const": 1
    },
    "transcript_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schemas": {
      "type": "object",
      "required": ["header", "exchange"],
      "properties": {
        "header": {
          "const": "urn:science-facility:para-agent:schema:transcript-header:1"
        },
        "exchange": {
          "const": "urn:science-facility:para-agent:schema:transcript-exchange:1"
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "para-agent"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instance_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "description": "The stable para-agent ledger session, distinct from all native client conversations.",
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["default_root", "selection_policy"],
      "properties": {
        "default_root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "selection_policy": {
          "const": "primary_workspace"
        }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "description": "Stable logical seats referenced by terminal exchange rows. Uniqueness is enforced by repository semantic validation.",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "properties": {
        "participants": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "primary"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "participants": {
          "type": "array",
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "para"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "applicationSelection": {
      "type": "object",
      "description": "A configured default client selection. It is not exchange-time provenance.",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "adapterBinding": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "profile_id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "defaultBinding": {
      "type": "object",
      "required": ["application", "adapter"],
      "properties": {
        "application": {
          "$ref": "#/$defs/applicationSelection"
        },
        "adapter": {
          "$ref": "#/$defs/adapterBinding"
        }
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": ["participant_id", "role"],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "enum": ["primary", "para"]
        },
        "registration_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "default_binding": {
          "$ref": "#/$defs/defaultBinding"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  }
}
