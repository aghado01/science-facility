{
  "schema_version": 1,
  "client_id": "codex",
  "display_name": "OpenAI Codex CLI",
  "provenance_mappings": {
    "thread_id": "_thread_id",
    "turn_id": "_turn_id",
    "model": "_model",
    "effort": "_effort",
    "user_label": "_user_label"
  },
  "record_mappings": {
    "prompt": {
      "native_type": "prompt",
      "text_path": "text",
      "timestamp_path": "_timestamp"
    },
    "thinking": {
      "native_type": "thinking",
      "text_path": "text",
      "timestamp_path": "_timestamp"
    },
    "tool_call": {
      "native_type": "tool_call",
      "tool_name_path": "tool_name",
      "tool_kind_path": "tool_kind",
      "tool_use_id_path": "tool_use_id",
      "input_path": "input",
      "result_path": "response",
      "status_path": "status"
    },
    "response": {
      "native_type": "response",
      "text_path": "text",
      "timestamp_path": "_timestamp",
      "phase_path": "phase"
    }
  }
}
