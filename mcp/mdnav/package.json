{
  "name": "mdnav",
  "version": "0.3.0",
  "description": "Structure-aware navigation, byte-span addressability, and MCP server for Markdown corpora",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "mdnav": "mdnav.mjs"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "node ../mdnav_v2/deps/node_modules/typescript/bin/tsc --noEmit",
    "test": "node test/run-all.mjs",
    "test:cli": "node test/acceptance.mjs",
    "test:engine": "node test/engine-test.mjs",
    "test:journal": "node test/journal-test.mjs",
    "test:render": "node test/render-test.mjs",
    "test:frames": "node test/frame-matrix-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
