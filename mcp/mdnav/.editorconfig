root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# the legacy oracle is never edited, by any tool
[mdnav.mjs]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
