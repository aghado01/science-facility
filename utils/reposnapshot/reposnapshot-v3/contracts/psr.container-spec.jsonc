{
  "name": "Piped Snapshot Rows (`psr`)",
  "version": "0.2",
  "description": "PSR — piped snapshot rows. header/zero-row declares pipe-separated column names and data types formatted as `name` : `type` pairs. each psr file contains exactly one header row, and at least one record row, with all rows occupying a single physical line.",
  "properties": {
    "file_ext": ".txt",
    "encoding": "utf-8",
    "bom": false
  },
  "row_schemas": {
    "header_row_schema": {
      "type": "array",
      "required": true,
      "pattern": "", //need to revise this pattern to either be wildcard for different types of encoded new lines, or strict based on guarantees from upstream 
      "description": "list of columns of the header row, types for corresponding record row items are inferred via binding ",
      "properties": {
        "gidx": {
          "description": "Global, group agnostic sequential ordinal.",
          "required": true,
          "type": "string",
          "position": 0,
          "row_type": "int",
          "row_width": 4,
          "row_value": {
            "$ref": "path/to/connected/contract/schema/file/attribute"
          },
          "pattern": "^[0-9]{4}$"
        },
        "path": {
          "description": "Relative POSIX path to snapshot-scoped root",
          "required": true,
          "type": "string",
          "position": 1,
          "row_type": "string",
          "row_value": {
            "$ref": "path/to/connected/contract/schema/file/attribute"
          },
          "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
        },
        "content_meta": {
          "description": "A nested array of field names in the content_meta block; values for row entries are caculated during ingestion with content_metadata processor",
          "type": "string",
          "required": false,
          "position": 2,
          "enclosure": "[]",
          "separator": ",",
          "pattern": "^(?:\\{[^;{}]+\\s*(?:;\\s*[^;{}]+\\s*)*\\},)*$",
          "row_type": "array", // of values, without keys/names 
          "properties": {
            "num_lines": {
              "val_rank": 0,
              "val_type": "int",
              "val": {
                "$ref": "record.ContentMeta.LineStats.Mean"
              },
              "default": true
            },
            "num_chars": {
              "val_rank": 1,
              "val_type": "int",
              "val": {
                "$ref": "record.ContentMeta.CharCount"
              },
              "default": true
            },
            "num_words": {
              "val_rank": 2,
              "val_type": "int",
              "val": {
                "$ref": "record.ContentMeta.WordCount"
              },
              "default": true
            },
            "num_unique_chars": {
              "val_rank": 3,
              "val_type": "int",
              "val": {
                "$ref": "record.ContentMeta.UniqueChars"
              },
              "default": false
              "val": {
                "$ref": "record.ContentMeta.UniqueChars"
              }
            },
            "num_unique_words": {
              "val_rank": 4,
              "val_type": "int",
              "val": {
                "$ref": "record.ContentMeta.UniqueWords"
              },
              "default": false
            },
            "punct_ratio": {
              "val_rank": 5,
              "val_type": "double",
              "val": {
                "$ref": "record.ContentMeta.PunctuationRatio"
              },
              "default": false
            },
            "ws_ratio": {
              "val_rank": 6,
              "val_type": "double",
              "val": {
                "$ref": "record.ContentMeta.WhitespaceRatio"
              },
              "default": true
            },
            "entropy": {
              "val_rank": 7,
              "val_type": "double",
              "val": {
                "$ref": "record.ContentMeta.Entropy"
              },
              "default": true
            }
          }
        },
        "content_bytes": {
          "description": "the byte length prefix. encodes the span of encoded byte width of the subsequent content block",
          "position": 3,
          "type": "string",
          "row_type": "int"
        },
        "content": {
          "description": "Processed content with line break substitutions encoded with idiomatic C-style escape sequence substitutions",
          "position": 4,
          "type": "string",
          "row_type": "string"
        }
      }
    }
  }
}