{
  "name": "Piped Snapshot Rows (`psr`)",
  "version": "0.2",
  "description": "PSR — piped snapshot rows. header/zero-row declares pipe-separated column names and data types formatted as `name` : `type` pairs. each psr file contains exactly one header row, and at least one record row, with all rows occupying a single physical line.",
  "properties": {
    "file_ext": ".txt",
    "encoding": "utf-8",
    "bom": false
  },
  "shard_container_schema": {
    "type": "array",
    "required": true,
    "record_delimiter": "\n",
    "column_separator": "|",
    "record_pattern": "^[^|\\r\\n]*(?:${column_separator}[^|\\r\\n]*)*${record_delimiter}$",
    "description": "list of columns of the header row, types for corresponding record row items are inferred via binding ",
    "properties": {
      "gidx": {
        "description": "Global, group agnostic sequential ordinal.",
        "required": true,
        "type": "string",
        "col_position": 0,
        "record_type": "int",
        "record_width": 4,
        "record_value": {
          "$ref": "psr.crosswalk.jsonc#/record/<attribute>"
        },
        "record_pattern": "^[0-9]{${gidx.record_width}}$"
      },
      "path": {
        "description": "Relative POSIX path to snapshot-scoped root",
        "required": true,
        "type": "string",
        "col_position": 1,
        "record_type": "string",
        "record_value": {
          "$ref": "psr.crosswalk.jsonc#/record/<attribute>"
        },
        "record_pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
      },
      "content_meta": {
        "description": "A nested array of field names in the content_meta block; values for row entries are caculated during ingestion with content_metadata processor",
        "type": "string",
        "required": false,
        "col_position": 2,
        "record_type": "array", // of values, without keys/names 
        "record_val_enclosure": {
          "start": "[",
          "end": "]"
        },
        "val_separator": ",",
        "record_pattern": "^${record_val_enclosure.start}\\s*[^${record_val_enclosure.val_separator}${record_val_enclosure.start}${record_val_enclosure.end}]+\\s*(?:${record_val_enclosure.val_separator}\\s*[^${record_val_enclosure.val_separator}${record_val_enclosure.start}${record_val_enclosure.end}]+\\s*)*${record_val_enclosure.end}\\s*$",
        "properties": {
          "num_lines": {
            "val_rank": 0,
            "val_type": "int",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": true
          },
          "num_chars": {
            "val_rank": 1,
            "val_type": "int",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": true
          },
          "num_words": {
            "val_rank": 2,
            "val_type": "int",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": true
          },
          "num_unique_chars": {
            "val_rank": 3,
            "val_type": "int",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": false
          },
          "num_unique_words": {
            "val_rank": 4,
            "val_type": "int",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": false
          },
          "punct_ratio": {
            "val_rank": 5,
            "val_type": "double",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": false
          },
          "ws_ratio": {
            "val_rank": 6,
            "val_type": "double",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": true
          },
          "entropy": {
            "val_rank": 7,
            "val_type": "double",
            "val": {
              "$ref": "#placeholder/tbd"
            },
            "default": true
          }
        }
      },
      "content_bytes": {
        "description": "the byte length prefix. encodes the span of encoded byte width of the subsequent content block",
        "col_position": 3,
        "type": "string",
        "record_type": "int"
      },
      "content": {
        "description": "Processed content with line break substitutions encoded with idiomatic C-style escape sequence substitutions",
        "col_position": 4,
        "type": "string",
        "record_type": "string"
      }
    }
  }
}