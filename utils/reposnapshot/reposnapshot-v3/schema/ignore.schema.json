{
  "stage": "ignore",
  "module": "rs.core.ignore.psm1 — New-IgnoreCompiler(-CrawlerGraph …) then Invoke-IgnoreFilter(-CompiledNodes -CrawlerGraph …)",
  "$comment": "Pure filter over the crawler graph. Takes a SLICE of crawler.out (the `from` fields below); rebuilds nodes with its own shape (out.node) and keeps file descriptors as the same objects (out.file = crawler.out.file). Anything in crawler.out.node not in out.node — the subtree rollups — is reachable downstream only by joining ignore.out ⋈ crawler.out on NodePath (the orchestrator retains crawler.out). Fails fast if a descriptor lacks RelativePath or Extension.",
  "in": {
    "params": {
      "IngestMode":             { "type": "Ignore|Selection", "note": "compiler; Design v3 semantics inversion (reports/ignore-selection-inversion.md)" },
      "IgnoreDefaults":         { "type": "string[]", "note": "compiler; default ['.snapshot/', '.git/', 'node_modules/']" },
      "IgnorePatterns":         { "type": "string[]", "optional": true },
      "IgnoreOverridePatterns": { "type": "string[]", "optional": true },
      "SelectionPatterns":      { "type": "string[]", "optional": true },
      "SentinelFileNames":      { "type": "string[]", "note": "compiler; default ['.gitignore', '.snapignore']; read from disk by AbsolutePath" },
      "MaxSizeBytes":           { "type": "long",     "note": "filter; 0 = no ceiling" },
      "ExtensionBlacklist":     { "type": "string[]", "optional": true, "note": "filter; additive to the hard blacklist" }
    },
    "node": {
      "NodePath":     { "from": "crawler.out.node" },
      "AbsolutePath": { "from": "crawler.out.node" },
      "NodeDepth":    { "from": "crawler.out.node" },
      "Files":        { "from": "crawler.out.node" }
    },
    "file": {
      "AbsolutePath": { "from": "crawler.out.file", "note": "sentinel reads; skip records" },
      "RelativePath": { "from": "crawler.out.file", "note": "pattern matching; contract check" },
      "Extension":    { "from": "crawler.out.file", "note": "blacklist; contract check" },
      "SizeBytes":    { "from": "crawler.out.file", "note": "MaxSizeBytes ceiling" }
    }
  },
  "out": {
    "result": {
      "Graph":   { "type": "Dictionary[NodePath, node]", "note": "pruned; empty leaves removed" },
      "Skipped": { "type": "skipped[]" }
    },
    "node": {
      "NodePath":      { "from": "crawler.out.node" },
      "AbsolutePath":  { "from": "crawler.out.node" },
      "NodeDepth":     { "from": "crawler.out.node" },
      "Files":         { "type": "file[]", "note": "surviving descriptors — same objects as crawler.out.file, filtered" },
      "CompiledState": { "type": "object", "note": "regime-stamped compiled ignore/selection state for the node" }
    },
    "file": {
      "AbsolutePath": { "from": "crawler.out.file" },
      "RelativePath": { "from": "crawler.out.file" },
      "NodePath":     { "from": "crawler.out.file" },
      "Extension":    { "from": "crawler.out.file" },
      "SizeBytes":    { "from": "crawler.out.file" },
      "LastWriteUtc": { "from": "crawler.out.file" },
      "CreationUtc":  { "from": "crawler.out.file" },
      "FsAttributes": { "from": "crawler.out.file" }
    },
    "skipped": {
      "Path":      { "type": "string" },
      "Reason":    { "type": "string", "note": "FileTooLarge | ExtensionBlacklisted" },
      "SizeBytes": { "type": "long",   "optional": true, "note": "with FileTooLarge" },
      "Extension": { "type": "string", "optional": true, "note": "with ExtensionBlacklisted" }
    }
  }
}
