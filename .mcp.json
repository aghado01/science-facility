{
  "mcpServers": {
    "para-agent": {
      "command": "node",
      "args": [
        "./mcp/para-agent/src/index.js"
      ],
      "env": {
        "PSMUX_NO_WARM": "1",
        "PARA_MUX_BIN": "./mcp/para-agent/deps/bin/mux/tmux.exe",
        "PARA_MUX_CONFIG_FILE": "./mcp/para-agent/config/mux/mux.conf",
        "PARA_NU_BIN": "./mcp/para-agent/deps/bin/nu/nu.exe"
      }
    },
    "pwsh_exec": {
      "command": "./mcp/pwsh_exec/deps/python/cpython-3.13.6-windows-x86_64-none/python.exe",
      "args": [
        "-B",
        "./mcp/pwsh_exec/server.py"
      ],
      "tool_timeout_sec": 8400,
      "env": {
        "MCP_POWERSHELL_EXECUTABLE": "./mcp/pwsh_exec/deps/bin/pwsh/pwsh.exe",
        "MCP_POWERSHELL_PROFILE": "./mcp/pwsh_exec/scripts/pwsh/profile-pwsh.ps1"
      }
    },
    "nushell": {
      "command": "./mcp/nushell-mcp/deps/nushell/nu.exe",
      "args": [
        "--mcp",
        "--config",
        "./mcp/nushell-mcp/config.nu"
      ],
      "env": {
        "NU_MCP_OUTPUT_LIMIT": "20kb",
        "NO_COLOR": "1",
        "NU_LOG_LEVEL": "warn"
      }
    },
    "mdnav": {
      "command": "node",
      "args": [
        "./mcp/mdnav/src/index.ts"
      ]
    }
  }
}