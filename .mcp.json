{
  "mcpServers": {
    "para-agent": {
      "command": "node",
      "args": [
        "./mcp/para-agent/src/index.js"
      ],
      "env": {
        "PSMUX_NO_WARM": "1",
        "PARA_MUX_BIN": "./mcp/para-agent/bin/mux/tmux.exe",
        "PARA_MUX_CONFIG_FILE": "./mcp/para-agent/bin/mux/mux.conf",
        "PARA_NU_BIN": "./mcp/para-agent/bin/nu/nu.exe"
      }
    }
  }
}
